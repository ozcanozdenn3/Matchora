{
  "name": "matchora-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "MATCHORA_ENV=development node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "audit:release": "node --env-file-if-exists=.env scripts/release-audit.mjs",
    "seed": "node scripts/seed.mjs",
    "supabase:bundle": "node scripts/supabase-bundle.mjs"
  },
  "dependencies": {
    "pg": "8.16.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14"
  }
}
