MATCHORA_ENV=development
HOST=127.0.0.1
PORT=8787
SQLITE_PATH=./var/matchora.sqlite
# Supabase connection is deliberately not configured yet.
# DATABASE_URL=postgresql://...
# AUTH_USERINFO_URL=https://PROJECT.supabase.co/auth/v1/user
# AUTH_PUBLIC_KEY=...
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SERVER-ONLY-NEVER-IN-MOBILE
# SUPABASE_STORAGE_BUCKET=matchora-private
# Supabase Auth: enable Apple/Google providers; allow the generated matchora://auth/callback?flow=... redirect.
# Email sign-in: enable Email, include {{ .Token }} in the Magic Link template (6-digit OTP),
# and configure production SMTP in Supabase. No email credential belongs in the mobile app.
# Auth redirect allowlist: matchora://auth/callback**
# SMS_GATEWAY_URL=https://...
# SMS_GATEWAY_TOKEN=...
# Alternative direct SMS (no custom gateway code required):
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_MESSAGING_SERVICE_SID=MG...
# TWILIO_FROM=+...
# CHECKIN_SECRET=minimum-32-random-characters
# BILLING_WEBHOOK_SECRET=minimum-32-random-characters
# REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer-long-private-random-value
# REVENUECAT_APPLE_PUBLIC_KEY=appl_...
# REVENUECAT_GOOGLE_PUBLIC_KEY=goog_...
# REVENUECAT_SECRET_KEY=sk_SERVER_ONLY
# Client logical SKU -> actual store product ID. Android subscription IDs include :base-plan.
# REVENUECAT_APPLE_PRODUCT_IDS={"tkn_50":"com.matchora.tokens.50","pro_monthly":"com.matchora.plus.monthly"}
# REVENUECAT_GOOGLE_PRODUCT_IDS={"tkn_50":"tokens_50","pro_monthly":"plus:monthly"}
# REVENUECAT_PRODUCT_MAP={"store.product.id":"pro_monthly"}
# PUSH_GATEWAY_URL=https://...
# PUSH_GATEWAY_TOKEN=...
# Alternatively use direct APNs / FCM delivery. Supply secrets only to the server.
# APNS_KEY_ID=...
# APNS_TEAM_ID=...
# APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_BUNDLE_ID=com.ozdentech.matchora
# APNS_SANDBOX=false
# FCM_PROJECT_ID=...
# FCM_CLIENT_EMAIL=...
# FCM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# PUBLIC_API_URL=https://api.example.com
# PRIVACY_URL=https://example.com/privacy
# TERMS_URL=https://example.com/terms
# PRIVACY_VERSION=1
# TERMS_VERSION=1
# COMMUNITY_GUIDELINES_URL=https://example.com/community-guidelines
# ACCOUNT_DELETION_URL=https://example.com/delete-account
# SUPPORT_EMAIL=...
# CORS_ORIGINS=https://example.com
# ADMIN_SUBJECTS=provider-subject-1,provider-subject-2
# Development helpers are NEVER available in production.
DEV_AUTH_ENABLED=false

# Optional separate server-only Supabase Auth admin key. Defaults to SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_AUTH_ADMIN_KEY=
